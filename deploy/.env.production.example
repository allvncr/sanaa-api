# Copier ce fichier en /var/www/sanaa/backend/.env sur le VPS et remplir les
# valeurs réelles. Ne jamais commiter le .env rempli (déjà dans .gitignore).

NODE_ENV=production
PORT=4000

# Le code calcule ses bornes "jour/semaine/mois/année" (exports, dashboard,
# encaissements) en UTC — mais TZ=UTC pin explicitement le processus Node
# quel que soit le fuseau système du serveur, en défense en profondeur (voir
# aussi `timedatectl set-timezone UTC` recommandé dans le README).
TZ=UTC

# Même base Atlas qu'aujourd'hui (Render) — copier la valeur telle quelle
# depuis Render > Environment, ou depuis Atlas si vous la faites tourner.
MONGODB_URI=

# Copier tels quels depuis les variables d'environnement actuelles de Render
# (Render > sanaa-api > Environment) : NE PAS régénérer, ça déconnecterait
# tous les utilisateurs déjà connectés.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

DEVISE_REFERENCE_GLOBALE=XOF

# Frontend et backend sont servis sur le même domaine via Nginx (proxy /api/v1
# vers 127.0.0.1:4000) : les requêtes du navigateur sont same-origin et CORS
# n'a plus vraiment besoin d'être ouvert. On restreint quand même par prudence
# (ex. si un autre client venait à appeler l'API directement).
CORS_ORIGIN=https://votre-domaine.com

EXPORTS_DIR=./storage/exports
